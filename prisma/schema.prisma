/// Compte de trésorerie : une caisse et un compte bancaire par société.
///
/// `soldeInitial` + `dateSoldeInitial` définissent le point de départ du
/// calcul du solde : en D2, `soldeReel` devra filtrer les mouvements avec
/// `dateOperation >= compte.dateSoldeInitial` — sinon l'historique antérieur
/// à la date de solde serait compté à tort.
model CompteTresorerie {
  id                   String               @id @default(cuid())
  companyId            String
  type                 TypeCompte
  libelle              String
  companyBankAccountId String?
  /// Solde de départ, toujours positif/nul ; les mouvements viennent s'y ajouter.
  soldeInitial         Decimal              @default(0) @db.Decimal(19, 4)
  /// Début de la fenêtre pertinente des mouvements (cf. note modèle ci-dessus).
  dateSoldeInitial     DateTime
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyBankAccount   CompanyBankAccount?  @relation(fields: [companyBankAccountId], references: [id], onDelete: SetNull)
  mouvements           MouvementTresorerie[]

  @@unique([companyId, type])
  @@index([companyBankAccountId])
  @@map("comptes_tresorerie")
}

/// Écriture du grand livre de trésorerie.
///
/// - `montant` est TOUJOURS positif : le signe du flux vient de `sens`.
/// - `annuleParId` vit sur l'écriture ORIGINALE : il pointe vers l'écriture
///   inverse (contre-passation) qui l'a annulée (sens littéral de "annulé par").
///   En annulation par contre-passation, l'origine reste `REALISE` : seul le
///   lien vers l'écriture inverse documente l'annulation.
/// - `cleSource` porte la clé déterministe de la source backfillée
///   (`payment:<id>`, `cheque:<id>`, `effet:<id>`, `mf:<id>`) et garantit
///   l'idempotence du backfill (contrainte `@unique` + `skipDuplicates`).
model MouvementTresorerie {
  id                   String                @id @default(cuid())
  companyId            String
  compteId             String
  sens                 SensMouvement
  mode                 ModeReglement
  statut               StatutMouvement
  /// Montant TOUJOURS positif (jamais <= 0) ; le signe vient de `sens`.
  montant              Decimal               @db.Decimal(19, 4)
  devise               String                @default("TND")
  montantTND           Decimal?              @db.Decimal(19, 4)
  dateOperation        DateTime
  /// = `dateOperation` si statut REALISE, null sinon (règle D2).
  dateValeur           DateTime?
  dateEcheance         DateTime?
  tiersId              String?
  invoiceId            String?
  achatId              String?
  avoirId              String?
  chequeId             String?
  effetId              String?
  /// Volontairement SANS `@unique` : un paiement peut produire 2 mouvements
  /// en D2 (escompte + agios) — l'unicité est portée par `cleSource`.
  paymentId            String?
  mouvementFinancierId String?
  libelle              String?
  reference            String?
  notes                String?
  /// Vit sur l'écriture ORIGINALE : `annuleParId` pointe vers l'écriture
  /// inverse (contre-passation) qui l'a annulée (sens littéral). En annulation
  /// par contre-passation, l'origine reste `REALISE`.
  annuleParId          String?
  annuleLe             DateTime?
  /// Clé déterministe de la source (`payment:<id>`, `cheque:<id>`, `effet:<id>`,
  /// `mf:<id>`) — unicité garantie, backfill idempotent.
  cleSource            String?               @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  annulePar            MouvementTresorerie?  @relation("ContrePassation", fields: [annuleParId], references: [id], onDelete: Restrict)
  achat                Achat?                @relation(fields: [achatId], references: [id], onDelete: SetNull)
  avoir                Avoir?                @relation(fields: [avoirId], references: [id], onDelete: SetNull)
  cheque               Cheque?               @relation(fields: [chequeId], references: [id], onDelete: SetNull)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  compte               CompteTresorerie      @relation(fields: [compteId], references: [id], onDelete: Restrict)
  effet                Effet?                @relation(fields: [effetId], references: [id], onDelete: SetNull)
  invoice              Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  mouvementFinancier   MouvementFinancier?   @relation(fields: [mouvementFinancierId], references: [id], onDelete: SetNull)
  payment              Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  tiers                Tiers?                @relation(fields: [tiersId], references: [id], onDelete: SetNull)
  contrePassages       MouvementTresorerie[] @relation("ContrePassation")

  @@index([companyId, statut, dateValeur])
  @@index([companyId, statut, dateOperation])
  @@index([companyId, statut, dateEcheance])
  @@index([companyId, compteId, statut, sens])
  @@index([tiersId])
  @@index([invoiceId])
  @@index([achatId])
  @@index([avoirId])
  @@index([chequeId])
  @@index([effetId])
  @@index([paymentId])
  @@index([mouvementFinancierId])
  @@index([annuleParId])
  @@map("mouvements_tresorerie")
}

