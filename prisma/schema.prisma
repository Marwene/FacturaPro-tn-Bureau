generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String?        @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String         @default("")
  role             UserRole       @default(USER)
  permissions      String[]
  actif            Boolean        @default(true)
  verificationCode String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  companyId        String?
  accounts         Account[]
  notifications    Notification[]
  sessions         Session[]
  userCompanies    UserCompany[]
  company          Company?       @relation(fields: [companyId], references: [id])

  @@map("users")
}

model UserCompany {
  userId    String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

model Company {
  id                   String               @id @default(cuid())
  name                 String
  matriculeFiscal      String?              @unique
  adresse              String?
  ville                String?
  codePostal           String?
  telephone            String?
  email                String?
  siteWeb              String?
  ribBancaire          String?
  banque               String?
  logo                 String?
  type                 String               @default("LOCALE")
  devise               String               @default("TND")
  deviseDefaut         String?
  tauxTVADefaut        Decimal              @default(19) @db.Decimal(5, 2)
  tauxFodecDefaut      Decimal              @default(1) @db.Decimal(5, 2)
  prefixeFacture       String               @default("FAC")
  prefixeDevis         String               @default("DEV")
  prefixeBL            String               @default("BL")
  prefixeBC            String               @default("BC")
  prefixeAchat         String               @default("ACH")
  prefixeBLAchat       String               @default("BL-A")
  prefixeAvoir         String               @default("AVOIR")
  anneeFormat          Boolean              @default(true)
  actif                Boolean              @default(true)
  cartonTypeIds        String[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  seuilSplitEffet      Decimal              @default(11500) @db.Decimal(12, 3)
  achats               Achat[]
  avoirs               Avoir[]
  bonsCommandes        BonCommande[]
  deliveryNotes        BonLivraison[]
  cartonTypes          CartonType[]
  cheques              Cheque[]
  comptesTresorerie    CompteTresorerie[]
  bankAccounts         CompanyBankAccount[]
  designsPersonnalises DesignPersonnalise[]
  effets               Effet[]
  exports              Export[]
  invoices             Invoice[]
  matieresPremieres    MatierePremiere[]
  mouvementsFinanciers MouvementFinancier[]
  mouvementsTresorerie MouvementTresorerie[]
  ngpCodes             NgpCode[]
  ordresFabrication    OrdreFabrication[]
  packingLists         PackingList[]
  payments             Payment[]
  quotes               Quote[]
  userCompanies        UserCompany[]
  users                User[]

  @@map("companies")
}

model AppSettings {
  id                  String    @id @default(cuid())
  alerteStockActif    Boolean   @default(true)
  alerteEcheanceJours Int       @default(7)
  openaiApiKey        String?   @default("")
  geminiApiKey        String?   @default("")
  mistralApiKey       String?   @default("")
  openrouterApiKey    String?   @default("")
  updatedAt           DateTime  @updatedAt
  tmmMajLe            DateTime?
  tmmTaux             Decimal?  @db.Decimal(5, 2)

  @@map("app_settings")
}

model Tiers {
  id                   String               @id @default(cuid())
  code                 String
  raisonSociale        String
  matriculeFiscal      String?              @unique
  adresse              String?
  ville                String?
  codePostal           String?
  telephone            String?
  email                String?
  siteWeb              String?
  isClient             Boolean              @default(true)
  isFournisseur        Boolean              @default(false)
  assujettTVA          Boolean              @default(true)
  exonereTVA           Boolean              @default(false)
  tauxRetenue          Decimal              @default(0) @db.Decimal(5, 2)
  creditLimit          Decimal              @default(0) @db.Decimal(19, 4)
  ribBancaire          String?
  banque               String?
  notes                String?
  actif                Boolean              @default(true)
  dateBlocage          DateTime?
  emailSentAt          DateTime?
  devise               String               @default("TND")
  deviseSecondaire     String?
  contactNom           String?
  contactTel           String?
  contactFonction      String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  achats               Achat[]
  avoirs               Avoir[]
  bonsCommandes        BonCommande[]
  deliveryNotes        BonLivraison[]
  cheques              Cheque[]
  effetsFournisseur    Effet[]              @relation("EffetFournisseur")
  effetsTire           Effet[]              @relation("EffetTireur")
  exports              Export[]
  invoices             Invoice[]
  matieresPremieres    MatierePremiere[]
  mouvementsFinanciers MouvementFinancier[]
  mouvementsTresorerie MouvementTresorerie[]
  ordresFabrication    OrdreFabrication[]
  payments             Payment[]
  products             Product[]
  productSuppliers     ProductSupplier[]
  quotes               Quote[]
  stockMovements       StockMovement[]

  @@index([code])
  @@index([email])
  @@map("tiers")
}

model Marque {
  id        String    @id @default(cuid())
  nom       String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("marques")
}

model Categorie {
  id        String      @id @default(cuid())
  nom       String
  parentId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  parent    Categorie?  @relation("CategoryTree", fields: [parentId], references: [id])
  enfants   Categorie[] @relation("CategoryTree")
  products  Product[]

  @@map("categories")
}

model Product {
  id                String               @id @default(cuid())
  code              String
  nom               String
  description       String?
  categorieId       String?
  marqueId          String?
  tiersId           String?
  photoUrl          String?
  ficheTechniqueUrl String?
  codeBarre         String?
  prixHT            Decimal              @db.Decimal(19, 4)
  prixAchat         Decimal              @default(0) @db.Decimal(19, 4)
  tauxTVA           Decimal              @default(19) @db.Decimal(5, 2)
  fodec             Boolean              @default(false)
  tauxFodec         Decimal              @default(1) @db.Decimal(5, 2)
  stockActuel       Decimal              @default(0) @db.Decimal(19, 3)
  stockMinimum      Decimal              @default(0) @db.Decimal(19, 3)
  unite             String               @default("Pièce")
  estSurCommande    Boolean              @default(false)
  quantiteParUnite  Decimal?             @db.Decimal(19, 3)
  stockStatus       StockStatus          @default(OK)
  actif             Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  achatLines        AchatLine[]
  avoirLines        AvoirLine[]
  bonCommandeLines  BonCommandeLine[]
  bonLivraisonLines BonLivraisonLine[]
  designs           DesignPersonnalise[]
  fichesTechniques  FicheTechnique[]
  invoiceLines      InvoiceLine[]
  stockMovements    StockMovement[]
  ordresFabrication OrdreFabrication[]
  variants          ProductVariant[]
  categorie         Categorie?           @relation(fields: [categorieId], references: [id])
  marque            Marque?              @relation(fields: [marqueId], references: [id])
  tiers             Tiers?               @relation(fields: [tiersId], references: [id])
  compositions      ProduitComposition[]
  quoteLines        QuoteLine[]
  suppliers         ProductSupplier[]

  @@index([code])
  @@index([categorieId])
  @@index([marqueId])
  @@index([stockStatus])
  @@map("products")
}

model ProductSupplier {
  id            String                        @id @default(cuid())
  productId     String
  supplierId    String
  purchasePrice Decimal                       @db.Decimal(19, 4)
  salePrice     Decimal?                      @db.Decimal(19, 4)
  reference     String?
  isDefault     Boolean                       @default(false)
  actif         Boolean                       @default(true)
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  priceHistory  ProductSupplierPriceHistory[]
  product       Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier      Tiers                         @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([productId])
  @@index([supplierId])
  @@map("product_suppliers")
}

model ProductSupplierPriceHistory {
  id                String          @id @default(cuid())
  productSupplierId String
  purchasePrice     Decimal         @db.Decimal(19, 4)
  changedAt         DateTime        @default(now())
  changedBy         String?
  reason            String?
  productSupplier   ProductSupplier @relation(fields: [productSupplierId], references: [id], onDelete: Cascade)

  @@index([productSupplierId])
  @@index([changedAt])
  @@map("product_supplier_price_history")
}

model ProductVariant {
  id                      String                   @id @default(cuid())
  productId               String
  nom                     String
  code                    String?
  attributs               Json?
  prixHT                  Decimal?                 @db.Decimal(19, 4)
  stockActuel             Decimal                  @default(0) @db.Decimal(19, 3)
  stockMinimum            Decimal                  @default(0) @db.Decimal(19, 3)
  photoUrl                String?
  actif                   Boolean                  @default(true)
  ordre                   Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bonCommandeLigneDetails BonCommandeLigneDetail[]
  bonLivraisonLines       BonLivraisonLine[]
  designs                 DesignPersonnalise[]
  invoiceLines            InvoiceLine[]
  stockMovements          StockMovement[]
  ordresFabrication       OrdreFabrication[]
  product                 Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  compositions            ProduitComposition[]
  quoteLines              QuoteLine[]

  @@map("product_variants")
}

model FicheTechnique {
  id        String   @id @default(cuid())
  productId String
  nom       String
  url       String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("fiches_techniques")
}

model MatierePremiere {
  id            String               @id @default(cuid())
  companyId     String
  code          String
  nom           String
  type          String
  unite         String
  prixUnitaire  Decimal              @default(0) @db.Decimal(19, 4)
  stockActuel   Decimal              @default(0) @db.Decimal(19, 3)
  stockMinimum  Decimal              @default(0) @db.Decimal(19, 3)
  fournisseurId String?
  description   String?
  actif         Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  company       Company              @relation(fields: [companyId], references: [id])
  fournisseur   Tiers?               @relation(fields: [fournisseurId], references: [id])
  ordres        OrdreMatiere[]
  compositions  ProduitComposition[]

  @@index([companyId])
  @@index([type])
  @@map("matieres_premieres")
}

model ProduitComposition {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  matiereId String
  quantite  Decimal         @db.Decimal(19, 4)
  unite     String
  matiere   MatierePremiere @relation(fields: [matiereId], references: [id])
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([matiereId])
  @@map("produit_compositions")
}

model DesignPersonnalise {
  id        String             @id @default(cuid())
  companyId String
  productId String
  variantId String?
  nom       String
  layers    Json
  thumbnail String?
  statut    String             @default("BROUILLON")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  company   Company            @relation(fields: [companyId], references: [id])
  product   Product            @relation(fields: [productId], references: [id])
  variant   ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  ordres    OrdreFabrication[]

  @@index([companyId])
  @@index([productId])
  @@map("designs_personnalises")
}

model OrdreFabrication {
  id                String              @id @default(cuid())
  companyId         String
  code              String
  tiersId           String?
  productId         String
  variantId         String?
  designId          String?
  bonCommandeLineId String?
  quantite          Int
  details           Json?
  statut            String              @default("BROUILLON")
  dateDebut         DateTime?
  dateFin           DateTime?
  dateLivraison     DateTime?
  ficheTechniqueUrl String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  bonCommandeLine   BonCommandeLine?    @relation(fields: [bonCommandeLineId], references: [id])
  company           Company             @relation(fields: [companyId], references: [id])
  design            DesignPersonnalise? @relation(fields: [designId], references: [id], onDelete: SetNull)
  product           Product             @relation(fields: [productId], references: [id])
  tiers             Tiers?              @relation(fields: [tiersId], references: [id])
  variant           ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  matieres          OrdreMatiere[]
  packingLists      PackingList[]

  @@index([companyId])
  @@index([tiersId])
  @@index([statut])
  @@index([code])
  @@index([bonCommandeLineId])
  @@map("ordres_fabrication")
}

model OrdreMatiere {
  id               String           @id @default(cuid())
  ordreId          String
  matiereId        String
  quantitePrevue   Decimal          @db.Decimal(19, 4)
  quantiteUtilisee Decimal          @default(0) @db.Decimal(19, 4)
  unite            String
  matiere          MatierePremiere  @relation(fields: [matiereId], references: [id])
  ordre            OrdreFabrication @relation(fields: [ordreId], references: [id], onDelete: Cascade)

  @@index([ordreId])
  @@index([matiereId])
  @@map("ordres_matieres")
}

model PackingList {
  id             String           @id @default(cuid())
  companyId      String
  ordreId        String
  numero         String
  capaciteCarton Int              @default(0)
  cartonTypes    Json?
  nbCartons      Int              @default(0)
  totalPieces    Int              @default(0)
  statut         String           @default("GENERE")
  packingListUrl String?
  etiquettesUrl  String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cartons        PackingCarton[]
  company        Company          @relation(fields: [companyId], references: [id])
  ordre          OrdreFabrication @relation(fields: [ordreId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([ordreId])
  @@index([numero])
  @@index([statut])
  @@map("packing_lists")
}

model PackingCarton {
  id            String      @id @default(cuid())
  packingListId String
  numero        Int
  contenu       Json
  totalPieces   Int         @default(0)
  capacite      Int?
  typeNom       String?
  createdAt     DateTime    @default(now())
  packingList   PackingList @relation(fields: [packingListId], references: [id], onDelete: Cascade)

  @@unique([packingListId, numero])
  @@index([packingListId])
  @@map("packing_cartons")
}

model CartonType {
  id        String   @id @default(cuid())
  nom       String
  capacite  Int
  longueur  Int?
  largeur   Int?
  hauteur   Int?
  companyId String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([nom])
  @@map("carton_types")
}

model Invoice {
  id            String                @id @default(cuid())
  numero        String
  tiersId       String
  companyId     String
  dateEmission  DateTime
  dateEcheance  DateTime?
  baseHT        Decimal               @db.Decimal(19, 4)
  totalHT       Decimal               @db.Decimal(19, 4)
  totalTVA      Decimal               @db.Decimal(19, 4)
  totalFodec    Decimal               @db.Decimal(19, 4)
  totalRetenue  Decimal               @db.Decimal(19, 4)
  totalTTC      Decimal               @db.Decimal(19, 4)
  montantPaye   Decimal               @default(0) @db.Decimal(19, 4)
  resteAPayer   Decimal               @db.Decimal(19, 4)
  status        InvoiceStatus         @default(BROUILLON)
  notes         String?
  bcViseActif   Boolean               @default(false)
  bcViseNumero  String?
  dateSN        DateTime?
  poids         Decimal?              @db.Decimal(10, 2)
  poidsBrut     Decimal?              @db.Decimal(10, 2)
  nbColis       Int?
  devise        String                @default("TND")
  tauxChange    Decimal?              @db.Decimal(10, 4)
  montantTND    Decimal?              @db.Decimal(19, 4)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  avoirs        Avoir[]
  cheques       Cheque[]
  effets        Effet[]
  exportLines   ExportLine[]
  lines         InvoiceLine[]
  company       Company               @relation(fields: [companyId], references: [id])
  tiers         Tiers                 @relation(fields: [tiersId], references: [id])
  payments      Payment[]
  quotes        Quote[]
  bonsLivraison InvoiceBonLivraison[]
  mouvementsTresorerie MouvementTresorerie[]

  @@unique([numero, companyId])
  @@index([companyId])
  @@index([tiersId])
  @@index([status])
  @@index([companyId, status])
  @@index([dateEcheance])
  @@map("invoices")
}

model InvoiceLine {
  id             String          @id @default(cuid())
  invoiceId      String
  productId      String?
  variantId      String?
  bonLivraisonId String?
  description    String
  quantite       Decimal         @db.Decimal(19, 3)
  prixHT         Decimal         @db.Decimal(19, 4)
  remise         Decimal         @default(0) @db.Decimal(5, 2)
  tauxTVA        Decimal         @db.Decimal(5, 2)
  fodec          Boolean         @default(false)
  tauxFodec      Decimal         @default(1) @db.Decimal(5, 2)
  totalHT        Decimal         @db.Decimal(19, 4)
  ordre          Int             @default(0)
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  bonLivraison   BonLivraison?   @relation(fields: [bonLivraisonId], references: [id])

  @@map("invoice_lines")
}

model InvoiceBonLivraison {
  id             String       @id @default(cuid())
  invoiceId      String
  bonLivraisonId String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bonLivraison   BonLivraison @relation(fields: [bonLivraisonId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([invoiceId, bonLivraisonId])
  @@map("invoice_bons_livraison")
}

model Quote {
  id             String         @id @default(cuid())
  numero         String
  tiersId        String
  companyId      String
  dateCreation   DateTime
  dateExpiration DateTime?
  baseHT         Decimal        @db.Decimal(19, 4)
  totalHT        Decimal        @db.Decimal(19, 4)
  totalTVA       Decimal        @db.Decimal(19, 4)
  totalFodec     Decimal        @db.Decimal(19, 4)
  totalTTC       Decimal        @db.Decimal(19, 4)
  status         QuoteStatus    @default(BROUILLON)
  notes          String?
  invoiceId      String?
  bonLivraisonId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  devise         String         @default("TND")
  montantTND     Decimal?       @db.Decimal(19, 4)
  tauxChange     Decimal?       @db.Decimal(10, 4)
  lines          QuoteLine[]
  company        Company        @relation(fields: [companyId], references: [id])
  tiers          Tiers          @relation(fields: [tiersId], references: [id])
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  deliveryNotes  BonLivraison[]

  @@unique([numero, companyId])
  @@index([companyId])
  @@index([tiersId])
  @@index([status])
  @@index([companyId, status])
  @@map("quotes")
}

model QuoteLine {
  id          String          @id @default(cuid())
  quoteId     String
  productId   String?
  variantId   String?
  description String
  quantite    Decimal         @db.Decimal(19, 3)
  prixHT      Decimal         @db.Decimal(19, 4)
  remise      Decimal         @default(0) @db.Decimal(5, 2)
  tauxTVA     Decimal         @db.Decimal(5, 2)
  fodec       Boolean         @default(false)
  tauxFodec   Decimal         @default(1) @db.Decimal(5, 2)
  totalHT     Decimal         @db.Decimal(19, 4)
  ordre       Int             @default(0)
  product     Product?        @relation(fields: [productId], references: [id])
  quote       Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("quote_lines")
}

model BonCommande {
  id              String            @id @default(cuid())
  numero          String
  tiersId         String
  companyId       String
  dateCreation    DateTime
  dateExpiration  DateTime?
  baseHT          Decimal           @db.Decimal(19, 4)
  totalHT         Decimal           @db.Decimal(19, 4)
  totalTVA        Decimal           @db.Decimal(19, 4)
  totalFodec      Decimal           @db.Decimal(19, 4)
  totalTTC        Decimal           @db.Decimal(19, 4)
  status          BonCommandeStatus @default(BROUILLON)
  notes           String?
  referenceClient String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  company         Company           @relation(fields: [companyId], references: [id])
  tiers           Tiers             @relation(fields: [tiersId], references: [id])
  lines           BonCommandeLine[]
  livraisons      BonLivraison[]

  @@unique([numero, companyId])
  @@index([companyId])
  @@index([tiersId])
  @@index([status])
  @@index([companyId, status])
  @@map("bons_commande")
}

model BonCommandeLine {
  id                   String                   @id @default(cuid())
  bonCommandeId        String
  productId            String?
  description          String
  quantite             Decimal                  @db.Decimal(19, 3)
  prixHT               Decimal                  @db.Decimal(19, 4)
  remise               Decimal                  @default(0) @db.Decimal(5, 2)
  tauxTVA              Decimal                  @db.Decimal(5, 2)
  fodec                Boolean                  @default(false)
  tauxFodec            Decimal                  @default(1) @db.Decimal(5, 2)
  totalHT              Decimal                  @db.Decimal(19, 4)
  ordre                Int                      @default(0)
  typeSource           SourceLigne              @default(STOCK)
  quantiteDetaillee    Decimal                  @default(0) @db.Decimal(19, 3)
  statutRapprochement  StatutRapprochement      @default(EN_ATTENTE_DETAIL)
  derniereVerification DateTime?
  details              BonCommandeLigneDetail[]
  bonCommande          BonCommande              @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)
  product              Product?                 @relation(fields: [productId], references: [id])
  notifications        Notification[]
  ordresFabrication    OrdreFabrication[]

  @@index([statutRapprochement])
  @@map("bons_commande_lines")
}

model BonCommandeLigneDetail {
  id                String          @id @default(cuid())
  bonCommandeLineId String
  variantId         String?
  taille            String?
  couleur           String?
  broderie          String?
  impressionDtf     String?
