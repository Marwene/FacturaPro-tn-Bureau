/// Compteur de fenêtre glissante/fixe pour le rate-limiting des routes d'auth.
/// Une ligne = une clé (scope + dimension + identifiant) et une fenêtre glissante.
model RateLimitBucket {
  /// Clé opaque : `${scope}:${dimension}:${identifiant}` (ex. `login:ip:1.2.3.4`).
  key         String   @id
  /// Début de la fenêtre de comptage (fenêtre fixe).
  windowStart DateTime
  /// Nombre d'occurrences dans la fenêtre.
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
  @@map("rate_limit_buckets")
}

